# Accurate Open API Credentials
# Copy this file to .env and fill in your values


# Signature Secret untuk HMAC-SHA256
ACCURATE_API_SECRET=your_api_secret_here

# Bearer Token (dari OAuth flow atau token yang di-generate)
ACCURATE_BEARER_TOKEN=your_bearer_token_here

# Server code Accurate kamu (zeus, odin, dll)
# Cek di URL Accurate kamu: https://{server_code}.accurate.id
ACCURATE_SERVER_CODE=zeus
